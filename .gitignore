# Public-source allowlist. Unlisted files stay local.
# Review every new file for secrets before adding it here.
# Do not use git add -f to publish local data or development artifacts.
/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/LICENSE
!/README.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/install.sh
!/src/
/src/**
!/src/usr/
!/src/usr/local/
!/src/usr/local/bin/
!/src/usr/local/etc/
!/src/usr/local/pkg/
!/src/usr/local/www/
!/src/usr/local/etc/rc.d/
!/src/usr/local/pkg/mwddns/
!/src/usr/local/www/widgets/
!/src/usr/local/pkg/mwddns/locale/
!/src/usr/local/www/widgets/widgets/
!/src/usr/local/bin/mwddns_cron.php
!/src/usr/local/bin/mwddns_debug.py
!/src/usr/local/bin/mwddns_debug_snapshot.php
!/src/usr/local/bin/mwddns_gateway_watcher.py
!/src/usr/local/bin/mwddns_upgrade.py
!/src/usr/local/bin/mwddns_upgrade_config.php
!/src/usr/local/etc/rc.d/mwddns_watcher
!/src/usr/local/pkg/mwddns.inc
!/src/usr/local/pkg/mwddns.xml
!/src/usr/local/pkg/mwddns/alidns.php
!/src/usr/local/pkg/mwddns/aliesa.php
!/src/usr/local/pkg/mwddns/cloudflare.php
!/src/usr/local/pkg/mwddns/debug.inc
!/src/usr/local/pkg/mwddns/locale/zh_CN.php
!/src/usr/local/pkg/mwddns/locale/zh_HK.php
!/src/usr/local/pkg/mwddns/powerdns.php
!/src/usr/local/pkg/mwddns/upgrade.inc
!/src/usr/local/www/mwddns.php
!/src/usr/local/www/mwddns_debug.php
!/src/usr/local/www/mwddns_edit.php
!/src/usr/local/www/mwddns_upgrade.php
!/src/usr/local/www/widgets/widgets/mwddns.widget.php

# Local-only reports, tests, release tooling and generated packages.
/reports/
/dist/
/tests/
/RELEASE.md
/package-release.ps1

# Never publish credentials, diagnostics, caches or editor state.
**/.env
**/.env.*
**/__pycache__/
*.pyc
*.pyo
*.log
*.pem
*.key
*.p12
*.pfx
*.zip
*.bak
*.swp
.DS_Store
Thumbs.db
