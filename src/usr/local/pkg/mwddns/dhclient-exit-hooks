#!/bin/sh
# mwddns dhclient hook – ensure IP loss/renewal triggers immediate DNS sync
#
# This hook is invoked by /sbin/dhclient-script on RELEASE/STOP/EXPIRE/FAIL,
# covering cases where rc.linkup is not fired (e.g. manual release).

CMD="/usr/local/bin/mwddns_cron.php"
IFACE="${interface:-${new_interface:-${old_interface:-${1:-}}}}"

if [ -x "${CMD}" ]; then
    if [ -n "${IFACE}" ]; then
        # Run in background to avoid blocking dhclient teardown/renewal.
        "${CMD}" "${IFACE}" >/dev/null 2>&1 &
    else
        "${CMD}" >/dev/null 2>&1 &
    fi
fi

exit 0
