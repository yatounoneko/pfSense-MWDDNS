<?php
/* Read-only watcher health and the pfSense *.sh boot entry point. */

function mwddns_install_watcher_boot_hook(): void
{
    // Generated rather than a new ZIP rc.d member: 1.1.3 accepts plugin .inc
    // additions but deliberately rejects arbitrary new rc.d archive paths.
    $path = '/usr/local/etc/rc.d/mwddns_watcher.sh';
    $body = <<<'SH'
#!/bin/sh
# Generated by MWDDNS. Interface/package reloads must not undo a manual stop.
[ -x /usr/local/etc/rc.d/mwddns_watcher ] || exit 0
case "${1:-}" in
    start) exec /usr/local/etc/rc.d/mwddns_watcher bootstart ;;
    stop) exec /usr/local/etc/rc.d/mwddns_watcher onestop ;;
esac
exit 0
SH;
    if (is_link($path) || is_link($path . '.tmp')) {
        throw new RuntimeException('Unsafe watcher boot hook path.');
    }
    if (file_put_contents($path . '.tmp', $body . "\n", LOCK_EX) === false ||
        !chmod($path . '.tmp', 0755) || !rename($path . '.tmp', $path)) {
        throw new RuntimeException('Cannot install watcher boot hook.');
    }
}

function mwddns_remove_watcher_boot_hook(): void
{
    $path = '/usr/local/etc/rc.d/mwddns_watcher.sh';
    if ((file_exists($path) || is_link($path)) && !unlink($path)) {
        throw new RuntimeException('Cannot remove watcher boot hook.');
    }
}

function mwddns_watcher_read_small(string $path, int $limit): string
{
    if (is_link($path) || !is_file($path) || !is_readable($path)) {
        return '';
    }
    $value = @file_get_contents($path, false, null, 0, $limit + 1);
    return is_string($value) && strlen($value) <= $limit ? trim($value) : '';
}

/** Pure classification shared by the GUI and diagnostic snapshot. */
function mwddns_watcher_classify(bool $supervisor, bool $worker, bool $stopped,
    bool $maintenance, ?int $age, bool $updating): string
{
    if ($maintenance) { return 'maintenance'; }
    if (!$worker) {
        if ($supervisor) { return 'recovering'; }
        return $stopped ? 'stopped' : 'not_running';
    }
    if (!$supervisor) { return 'unsupervised'; }
    if ($age === null) { return 'starting'; }
    if ($age > ($updating ? 150 : 60)) { return 'stale'; }
    return $updating ? 'updating' : 'running';
}

function mwddns_watcher_health(): array
{
    $base = '/var/run/mwddns_watcher';
    $pid = static function (string $path): ?int {
        $raw = mwddns_watcher_read_small($path, 32);
        return preg_match('/^[1-9][0-9]{0,8}$/D', $raw) ? (int)$raw : null;
    };
    $child = $pid($base . '.pid');
    $parent = $pid($base . '.supervisor.pid');
    $rows = [];
    $status = 0;
    $pids = array_filter([$child, $parent]);
    if ($pids) {
        // FreeBSD treats everything after '=' in one -o argument as a header.
        // Give each headerless column its own -o, rather than using '=,'.
        exec('/bin/ps -ww -p ' . escapeshellarg(implode(',', $pids)) .
            ' -o pid= -o ppid= -o state= -o comm= -o args= 2>/dev/null', $rows, $status);
    }
    $supervisor = false;
    $worker = false;
    $workerParent = null;
    $malformed = false;
    foreach ($rows as $row) {
        $parts = preg_split('/\s+/', trim($row), 5);
        if (count($parts) !== 5 || !preg_match('/^[1-9][0-9]*$/D', $parts[0]) ||
            !preg_match('/^[0-9]+$/D', $parts[1])) {
            $malformed = true;
            continue;
        }
        if (strpos($parts[2], 'Z') !== false) { continue; }
        if ((int)$parts[0] === $parent && basename($parts[3]) === 'daemon') {
            $supervisor = true;
        }
        if ((int)$parts[0] === $child && basename($parts[3]) === 'python3.11' &&
            preg_match('~(?:^|\s)/usr/local/bin/mwddns_gateway_watcher\.py(?:\s|$)~', $parts[4])) {
            $worker = true;
            $workerParent = (int)$parts[1];
        }
    }
    if ($worker && $workerParent !== $parent) { $supervisor = false; }
    $heartbeat = json_decode(mwddns_watcher_read_small($base . '.health.json', 2048), true);
    $age = null;
    $updating = false;
    if ($worker && is_array($heartbeat) && ($heartbeat['pid'] ?? null) === $child &&
        is_numeric($heartbeat['monotonic'] ?? null)) {
        // PHP hrtime and Python time.monotonic use the same system monotonic clock.
        $elapsed = hrtime(true) / 1000000000 - (float)$heartbeat['monotonic'];
        if (is_finite($elapsed) && $elapsed >= 0) { $age = (int)$elapsed; }
        $updating = ($heartbeat['phase'] ?? '') === 'updating';
    }
    $state = mwddns_watcher_classify($supervisor, $worker, file_exists($base . '.stopped'),
        is_dir('/var/run/mwddns-installing'), $age, $updating);
    // Vanished PIDs may return 1 without rows. Invalid/unexpected output is
    // not evidence that the service stopped, even when ps reports success.
    if ($status > 1 || $malformed || ($pids && $status === 0 && !$rows)) {
        $state = 'unknown';
    }
    return ['state' => $state, 'supervisor_running' => $supervisor,
        'worker_running' => $worker, 'heartbeat_age_seconds' => $age];
}

function mwddns_watcher_health_html(): string
{
    $health = mwddns_watcher_health();
    $labels = [
        'running' => ['success', 'Watcher is healthy'],
        'updating' => ['info', 'Watcher is updating DNS'],
        'starting' => ['warning', 'Watcher heartbeat unavailable'],
        'recovering' => ['warning', 'Watcher is recovering'],
        'stale' => ['danger', 'Watcher heartbeat is stale'],
        'unsupervised' => ['warning', 'Watcher is running without recovery protection'],
        'stopped' => ['warning', 'Watcher was stopped manually'],
        'not_running' => ['danger', 'Watcher is not running'],
        'maintenance' => ['info', 'Watcher maintenance in progress'],
        'unknown' => ['warning', 'Watcher status is unavailable'],
    ];
    [$style, $label] = $labels[$health['state']] ?? $labels['unknown'];
    $escape = static fn($s) => htmlspecialchars(mwddns_t($s), ENT_QUOTES, 'UTF-8');
    return '<div class="alert alert-' . $style . '" role="status">' .
        '<strong>' . $escape($label) . '</strong><br>' .
        $escape('Watcher health is separate from the last rule update. The five-minute cron fallback remains active. Refresh this page for current status.') . '</div>';
}
